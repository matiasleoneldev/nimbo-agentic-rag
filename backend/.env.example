OPENAI_API_KEY='your_openai_api_key_here'

LANGSMITH_API_KEY='your_langsmith_api_key_here'
LANGSMITH_TRACING=true
LANGSMITH_PROJECT='your_project_name_here'

# PostgreSQL + pgvector (docker compose service `db`). asyncpg driver is required on Windows.
DATABASE_URL='postgresql+asyncpg://nimbo:nimbo@localhost:5432/nimbo'
TEST_DATABASE_URL='postgresql+asyncpg://nimbo:nimbo@localhost:5432/nimbo_test'

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS='http://localhost:3000'
